{
  "rule": [
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 90,
        "isLive": false,
        "matchesStorageClass": [
          "STANDARD",
          "NEARLINE",
          "COLDLINE",
          "ARCHIVE"
        ]
      }
    },
    {
      "action": {
        "type": "AbortIncompleteMultipartUpload"
      },
      "condition": {
        "age": 7
      }
    },
    {
      "action": {
        "type": "SetStorageClass",
        "storageClass": "COLDLINE"
      },
      "condition": {
        "age": 365,
        "isLive": true
      }
    }
  ]
}