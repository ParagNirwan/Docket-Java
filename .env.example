# Database
POSTGRES_PASSWORD=docket_dev_password

# Backend (Spring Boot JWT)
JWT_SECRET=your_base64_encoded_jwt_secret_key_here
# Access token lifetime in ms (15 minutes). Sessions continue through the refresh cookie.
JWT_ACCESS_TOKEN_TTL_MS=900000

# Email: logging prints to the console (local only), smtp, resend or disabled.
# Docker Compose already points at Mailpit, so these are for running outside Docker.
# EMAIL_PROVIDER=logging
# EMAIL_FROM=Docket <no-reply@your-domain.com>
# RESEND_API_KEY=
# SMTP_HOST=localhost
# SMTP_PORT=1025
# APP_BASE_URL=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=/api
# Optional Vite proxy override. Docker Compose defaults to http://host.docker.internal:8080;
# local Vite defaults to http://localhost:8080.
# BACKEND_URL=http://localhost:8080
